# Frontend environment variables (set in Render Static Site)
NEXT_PUBLIC_WS_URL=wss://your-realtime-service.onrender.com
NEXT_PUBLIC_URL=https://your-site.onrender.com

# Realtime service environment variables (set in Render Web Service)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wishes
MONGODB_DB=wishes
ADMIN_PASSWORD=your-secure-admin-password
ALLOWED_ORIGIN=https://your-site.onrender.com
PORT=3001
