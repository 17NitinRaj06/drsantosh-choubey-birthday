# Frontend (Static Site) — NEXT_PUBLIC_* vars are embedded at build time

# WebSocket base URL of the realtime service (no path, no trailing slash).
# For local dev: ws://localhost:3001
# For production: wss://your-realtime-service.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# HTTP API base URL of the realtime service (no trailing slash).
# If unset, derived from NEXT_PUBLIC_WS_URL by swapping ws:// → http://.
# For local dev: http://localhost:3001
# For production: https://your-realtime-service.onrender.com
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Public URL of this static site (for QR codes, meta tags).
# For local dev: http://localhost:3000
# For production: https://your-static-site.onrender.com
NEXT_PUBLIC_URL=http://localhost:3000
