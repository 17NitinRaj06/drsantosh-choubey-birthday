# Realtime Service

# Server port (default: 3001)
PORT=3001

# MongoDB Atlas connection string (never commit real credentials)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wishes

# Database name (default: wishes)
MONGODB_DB=wishes

# Comma-separated allowed origins for CORS
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3456

# Admin panel password (required; admin routes disabled if empty)
ADMIN_PASSWORD=changeme
